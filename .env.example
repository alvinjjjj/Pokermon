# ── Public (bundled into client app) ──────────────────────────────────────────
# Safe to expose — these are either public-by-design or domain-locked.
EXPO_PUBLIC_POKEMON_TCG_KEY=your_pokemon_tcg_api_key
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Server-side only — NEVER add EXPO_PUBLIC_ prefix to these ─────────────────
# Used by local Node scripts AND must be set as Supabase secrets so Edge
# Function proxies (ppt-proxy, pc-proxy) can call upstream APIs:
#   supabase secrets set POKEPRICE_API_KEY=...
#   supabase secrets set PRICECHARTING_TOKEN=...
POKEPRICE_API_KEY=your_pokemonpricetracker_api_key
PRICECHARTING_TOKEN=your_pricecharting_token

# Local admin / seeding scripts only
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
